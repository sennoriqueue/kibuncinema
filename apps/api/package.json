{
  "name": "@kibuncinema/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply kibuncinema --local",
    "db:migrate:remote": "wrangler d1 migrations apply kibuncinema --remote",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.5",
    "@kibuncinema/db": "workspace:*",
    "@kibuncinema/shared": "workspace:*",
    "better-auth": "^1.3.34",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251120.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.50.0"
  }
}
