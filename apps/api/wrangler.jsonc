{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kibuncinema-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // API は画面の Worker から Service Binding で呼ぶだけなので、公開URL（workers.dev）は付けない。
  // 外から直接呼ばれて TMDB への問い合わせを増やされるのを防ぐ
  "workers_dev": false,

  // `wrangler d1 create kibuncinema` で表示された database_id に置き換える
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kibuncinema",
      "database_id": "39d75ff4-ce4a-467c-83f9-1f4f4234c4f9",
      "migrations_dir": "migrations"
    }
  ],

  // 1つの IP アドレスからのリクエスト数の制限（いたずらの連打で、無料枠や TMDB の制限を使い切られないように）。
  // Cloudflare の拠点ごとに数えるおおよその制限。period は 10 か 60（秒）
  "ratelimits": [
    { "name": "RECOMMEND_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "MOVIE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],

  // R2（アイコン画像の保存先）はログイン機能を止めているあいだ使わないので外している。
  // 戻すときは R2 を有効にして `wrangler r2 bucket create kibuncinema-assets` を実行し、次の行を戻す
  // "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "kibuncinema-assets" }],

  // 本番では Next.js 側の URL に変える（ログインのリダイレクト先にもなる）
  "vars": {
    "WEB_ORIGIN": "http://localhost:3000"
  }

  // シークレット（.dev.vars / `wrangler secret put`）:
  //   TMDB_TOKEN（必須）
  //   BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET（ログイン機能を使うときだけ）
}
