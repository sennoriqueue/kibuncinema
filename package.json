{
  "name": "kibuncinema",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @kibuncinema/api --filter @kibuncinema/web dev",
    "dev:api": "pnpm --filter @kibuncinema/api dev",
    "dev:web": "pnpm --filter @kibuncinema/web dev",
    "typecheck": "pnpm -r typecheck",
    "db:migrate:local": "pnpm --filter @kibuncinema/api db:migrate:local",
    "db:migrate:remote": "pnpm --filter @kibuncinema/api db:migrate:remote",
    "deploy": "pnpm --filter @kibuncinema/api run deploy && pnpm --filter @kibuncinema/web run deploy"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
